<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Phone_Format</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Phone__c)),
    NOT(REGEX(Phone__c, &quot;^[+]?[0-9 ()-]{7,20}$&quot;))
)</errorConditionFormula>
    <errorDisplayField>Phone__c</errorDisplayField>
    <errorMessage>Please enter a valid phone number (digits, spaces, dashes, parentheses, or an optional leading +).</errorMessage>
</ValidationRule>