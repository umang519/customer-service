<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Case Activity Summary</masterLabel>
    <description>Displays a compact summary of recent Tasks for a Case.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Case</object>
            </objects>
            <property name="rowLimit" type="Integer" default="10" label="Row Limit" description="Maximum number of recent activities to display."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>