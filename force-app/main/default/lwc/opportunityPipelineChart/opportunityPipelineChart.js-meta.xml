<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Opportunity Pipeline Chart</masterLabel>
    <description>Visualizes open opportunity amounts grouped by sales stage.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="chartType" type="String" label="Chart Type" description="Select bar or doughnut chart." datasource="bar,doughnut" default="bar"/>
            <property name="stageFilter" type="String" label="Stage Filter" description="Comma-separated StageName values to filter the pipeline. Leave blank for all open stages."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>